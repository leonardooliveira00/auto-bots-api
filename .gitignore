# ==========================================
# Dependências e Pacotes (Nunca commitar)
# ==========================================
node_modules/
/dist/
/.nebula
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Segurança e Variáveis de Ambiente (CRÍTICO)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key

# ==========================================
# Prisma (Ignorar migrações locais temporárias/banco sqlite se houver)
# ==========================================
/prisma/db
/prisma/*.db
/prisma/*.db-journal
/generated/

# ==========================================
# TypeScript e Compilação
# ==========================================
*.tsbuildinfo
tsconfig.tsbuildinfo

# ==========================================
# Docker e Redis (Caches locais e volumes)
# ==========================================
.docker/
docker-compose.override.yml
*.db
dump.rdb

# ==========================================
# IDEs e Editores de Código
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

