// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User{
  user_id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(50)
  lastname String @db.VarChar(50)
  email String @unique
  phoneNumber String @db.VarChar(11) @unique
  passwordHash String

  cpfHash String @unique
  cpfEncrypted String

  address Address?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Address{
  address_id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  street String
  number String
  complement String?
  city String
  state String
  postalCode String

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@map("addresses")
}

model Product {
  product_id String @id @default(uuid()) @db.Uuid
  sku String @unique
  name String @db.VarChar(255)
  description String? @db.Text
  price Decimal @db.Decimal(10, 2)
  isActive Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock Stock?
  movements StockMovement[]

  @@map("products")
}

model Stock {
  stock_id String @id @default(uuid()) @db.Uuid
  productId String @unique @map("product_id") @db.Uuid
  quantity Int @default(0)
  minQuantity Int @default(0) @map("min_stock")
  maxStock Int @map("max_stock")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [product_id], onDelete: Cascade)

  @@map("stocks")
}

enum MovementType {
  IN 
  OUT
}

model StockMovement {
  movement_id String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity Int
  type MovementType
  reason String? @db.VarChar(255)
  userId String @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [product_id], onDelete: Cascade) 

  @@map("stock_movements")
}