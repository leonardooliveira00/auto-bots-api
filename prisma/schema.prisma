// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String @map("password_hash")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee?

  @@map("users")
}

enum Role {
  Mechanic
  Attendant
  Admin
  Manager
}

model Employee{
  employee_id String @id @default(uuid()) @db.Uuid
  firstName String @db.VarChar(50)
  lastName String @db.VarChar(50)
  phone String @db.VarChar(11) @unique

  cpfHash String @unique @map("cpf_hash")
  cpfEncrypted String @map("cpf_encrypted")

  role Role
  salary Decimal @db.Decimal(10, 2)

  admissionDate DateTime @map("admission_date")
  resignationDate DateTime? @map("resignation_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userId String? @unique @db.Uuid @map("user_id")
  user User?  @relation(fields: [userId], references: [user_id], onDelete: SetNull)
  address Address?

  orderOfService OrderOfService[]

  @@map("employees")
}

model Address{
  address_id String @id @default(uuid()) @db.Uuid
  employeeId String @unique @db.Uuid @map("employee_id")
  street String
  number String
  district String
  complement String?
  city String
  state String
  postalCode String @map("postal_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [employee_id], onDelete: Cascade)

  @@map("addresses")
}

model Product {
  product_id String @id @default(uuid()) @db.Uuid
  sku String @unique
  name String @db.VarChar(255)
  description String? @db.Text
  price Decimal @db.Decimal(10, 2)
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock Stock?
  movements StockMovement[]

  osProducts OsProduct[]

  @@map("products")
}

model Stock {
  stock_id String @id @default(uuid()) @db.Uuid
  productId String @unique @map("product_id") @db.Uuid
  quantity Int @default(0)
  minStock Int @default(0) @map("min_stock")
  maxStock Int @map("max_stock")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [product_id], onDelete: Cascade)

  @@map("stocks")
}

enum MovementType {
  IN 
  OUT
}

model StockMovement {
  movement_id String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity Int
  type MovementType
  reason String? @db.VarChar(255)
  employeeId String @map("employee_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [product_id], onDelete: Cascade) 

  @@map("stock_movements")
}

model Customer {
  customer_id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(50)
  lastName String @db.VarChar(50)
  email String @unique
  phone String @db.VarChar(11)

  cpfOrCnpjHash String @unique @map("cpf_or_cnpj_hash")
  cpfOrCnpjEncrypted String @map("cpf_or_cnpj_encrypted")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  vehicles Vehicle[]

  @@map("customers")
}

model Vehicle {
  vehicle_id String @id @default(uuid()) @db.Uuid
  brand String @db.VarChar(50)
  model String @db.VarChar(50)
  year Int @db.SmallInt
  plate String @unique @db.VarChar(50)
  vin String @unique @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  customerId String @map("customer_id") @db.Uuid
  customer Customer @relation(fields: [customerId], references: [customer_id], onDelete: Restrict)

  orderOfService OrderOfService[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("vehicles")
}

enum OsStatus {
  BUDGET
  APPROVED
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELED
}

model OrderOfService {
  os_id String @id @default(uuid()) @db.Uuid
  protocol String
  description String?
  status OsStatus @default(BUDGET)

  estimatedDelivery DateTime? @map("estimated_delivery")

  totalProducts Decimal @default(0) @db.Decimal(10, 2)
  totalLabors Decimal @default(0) @db.Decimal(10, 2)
  totalAmount Decimal @default(0) @db.Decimal(10, 2)

  vehicleId String @db.Uuid @map("vehicle_id")
  vehicle Vehicle @relation(fields: [vehicleId], references: [vehicle_id], onDelete: Restrict)

  employeeId String @db.Uuid @map("employee_id")
  employee Employee @relation(fields: [employeeId], references: [employee_id], onDelete: Restrict)

  products OsProduct[]
  labors OsLabor[]

  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("orders_of_service")
}

model OsProduct {
  os_product_id String @id @default(uuid()) @db.Uuid
  osId String @db.Uuid @map("os_id")
  orderOfService OrderOfService @relation(fields: [osId], references: [os_id], onDelete: Cascade)

  productId String @db.Uuid @map("product_id")
  product Product @relation(fields: [productId], references: [product_id], onDelete: Restrict)

  quantity Int
  unitPrice Decimal
  totalPrice Decimal

  @@map("os_products")
}

model OsLabor {
  os_labor_id String @id @default(uuid()) @db.Uuid
  osId String @db.Uuid @map("os_id")
  orderOfService OrderOfService @relation(fields: [osId], references: [os_id], onDelete: Cascade)

  description String @db.VarChar(255)
  hours Decimal @db.Decimal(5, 2)
  hourlyRate Decimal @db.Decimal(10, 2) @map("hourly_rate")
  totalPrice Decimal @db.Decimal(10, 2) @map("total_price")

  @@map("os_labors")
}