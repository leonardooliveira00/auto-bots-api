generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId      String    @id @default(uuid()) @db.Uuid @map("user_id")
  email        String    @unique
  createdAt    DateTime  @default(now()) @map("created_at")
  passwordHash String    @map("password_hash")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  isActive     Boolean   @default(true) @map("is_active")
  employee     Employee?

  @@map("users")
}

model Employee {
  employeeId     String           @id @default(uuid()) @db.Uuid @map("employee_id")
  firstName       String           @db.VarChar(50)
  lastName        String           @db.VarChar(50)
  phone           String           @unique @db.VarChar(11)
  cpfHash         String           @unique @map("cpf_hash")
  cpfEncrypted    String           @map("cpf_encrypted")
  role            Role
  salary          Decimal          @db.Decimal(10, 2)
  admissionDate   DateTime         @map("admission_date")
  resignationDate DateTime?        @map("resignation_date")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  userId          String?          @unique @map("user_id") @db.Uuid
  address         Address?
  user            User?            @relation(fields: [userId], references: [userId])
  workOrder  WorkOrder[]

  @@map("employees")
}

model Address {
  addressId String   @id @default(uuid()) @db.Uuid @map("address_id")
  street     String
  number     String
  complement String?
  city       String
  state      String
  createdAt  DateTime @default(now()) @map("created_at")
  postalCode String   @map("postal_code")
  updatedAt  DateTime @updatedAt @map("updated_at")
  district   String
  employeeId String   @unique @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@map("addresses")
}

model Product {
  productId  String          @id @default(uuid()) @db.Uuid @map("product_id")
  sku         String          @unique
  name        String          @db.VarChar(255)
  description String?
  price       Decimal         @db.Decimal(10, 2)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  workOrderProducts  WorkOrderProduct[]
  movements   StockMovement[]
  stock       Stock?

  @@map("products")
}

model Stock {
  stockId  String   @id @default(uuid()) @db.Uuid @map("stock_id")
  productId String   @unique @map("product_id") @db.Uuid
  quantity  Int      @default(0)
  minStock  Int      @default(0) @map("min_stock")
  maxStock  Int      @map("max_stock")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@map("stocks")
}

model StockMovement {
  movementId String       @id @default(uuid()) @db.Uuid @map("movement_id")
  productId   String       @map("product_id") @db.Uuid
  quantity    Int
  type        MovementType
  reason      String?      @db.VarChar(255)
  createdAt   DateTime     @default(now()) @map("created_at")
  employeeId  String       @map("employee_id") @db.Uuid
  product     Product      @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@map("stock_movements")
}

model Customer {
  customerId        String    @id @default(uuid()) @db.Uuid @map("customer_id")
  name               String    @db.VarChar(50)
  lastName           String    @db.VarChar(50)
  email              String    @unique
  phone              String    @db.VarChar(11)
  cpfOrCnpjHash      String    @unique @map("cpf_or_cnpj_hash")
  cpfOrCnpjEncrypted String    @map("cpf_or_cnpj_encrypted")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  vehicles           Vehicle[]

  @@map("customers")
}

model Vehicle {
  vehicleId     String           @id @default(uuid()) @db.Uuid @map("vehicle_id")
  brand          String           @db.VarChar(50)
  model          String           @db.VarChar(50)
  year           Int              @db.SmallInt
  plate          String           @unique @db.VarChar(50)
  vin            String           @unique @db.VarChar(50)
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  customerId     String           @map("customer_id") @db.Uuid
  workOrder WorkOrder[]
  customer       Customer         @relation(fields: [customerId], references: [customerId])

  @@map("vehicles")
}

model WorkOrder {
  workOrderId            String      @id @default(uuid()) @db.Uuid @map("work_order_id")
  protocol          String
  description       String?
  status            WorkOrderStatus    @default(BUDGET)
  totalProducts     Decimal     @default(0) @db.Decimal(10, 2)
  totalLabors       Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal     @default(0) @db.Decimal(10, 2)
  vehicleId         String      @map("vehicle_id") @db.Uuid
  employeeId        String      @map("employee_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  estimatedDelivery DateTime?   @map("estimated_delivery")
  employee          Employee    @relation(fields: [employeeId], references: [employeeId])
  vehicle           Vehicle     @relation(fields: [vehicleId], references: [vehicleId])
  labors            WorkOrderLabor[]
  products          WorkOrderProduct[]

  @@map("work_orders")
}

model WorkOrderProduct {
  workOrderProductId  String         @id @default(uuid()) @db.Uuid @map("work_order_product_id")
  workOrderId           String         @map("work_order_id") @db.Uuid
  productId      String         @map("product_id") @db.Uuid
  quantity       Int
  unitPrice      Decimal @db.Decimal(10,2) @map("unit_price")
  totalPrice     Decimal @db.Decimal(10,2) @map("total_price")
  workOrder WorkOrder @relation(fields: [workOrderId], references: [workOrderId], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [productId])

  @@map("work_order_products")
}

model WorkOrderLabor {
  workOrderLaborId    String         @id @default(uuid()) @db.Uuid @map("work_order_labor_id")
  workOrderId           String         @map("work_order_id") @db.Uuid
  description    String         @db.VarChar(255)
  hours          Decimal        @db.Decimal(5, 2)
  hourlyRate     Decimal        @map("hourly_rate") @db.Decimal(10, 2)
  totalPrice     Decimal        @map("total_price") @db.Decimal(10, 2)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [workOrderId], onDelete: Cascade)

  @@map("work_order_labors")
}

enum Role {
  Mechanic
  Attendant
  Admin
  Manager
}

enum MovementType {
  IN
  OUT
}

enum WorkOrderStatus {
  BUDGET
  APPROVED
  IN_PROGRESS
  COMPLETED
  DELIVERED
  CANCELED
}
